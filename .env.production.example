# Copy to Coolify "Environment Variables" (build time) or to .env.production locally.
# Webpack bakes REACT_APP_* into the bundle at npm run build.

REACT_APP_API_BASE_URL=https://backend.c4r.co.uk

# Optional: force mock login in the production bundle (staging only).
# Not required for *.maktechgroup.tech — mock auth is enabled by hostname at runtime.
# REACT_APP_MOCK_AUTH=true
# REACT_APP_DEV_DEFAULT_EMAIL=admin@gmail.com
# REACT_APP_DEV_DEFAULT_PASSWORD=password123
